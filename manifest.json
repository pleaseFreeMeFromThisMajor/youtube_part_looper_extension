{
  "manifest_version": 3,
  "name": "Interval Looper",
  "version": "1.0",
  "description": "loop your favorite part only",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Interval Looper"
  }
}