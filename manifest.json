{
  "manifest_version": 3,
  "name": "YouTube Interval Looper",
  "version": "1.0",
  "description": "Lặp lại một đoạn video YouTube tùy chọn ngay trên trang web.",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "YouTube Interval Looper"
  }
}